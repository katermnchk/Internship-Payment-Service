<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/mongodb
        https://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <changeSet id="v1-2" author="ramenchyk-katsiaryna">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { order_id: 1 }
            </mongodb:keys>
            <mongodb:options>
                { "name": "idx_order_id" }
            </mongodb:options>
        </mongodb:createIndex>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { user_id: 1 }
            </mongodb:keys>
            <mongodb:options>
                { "name": "idx_user_id" }
            </mongodb:options>
        </mongodb:createIndex>

        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { status: 1 }
            </mongodb:keys>
            <mongodb:options>
                { "name": "idx_status" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

</databaseChangeLog>