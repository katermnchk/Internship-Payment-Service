<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
         http://www.liquibase.org/xml/ns/mongodb
         https://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">


<changeSet id="v1-1" author="ramenchyk-katsiaryna">
        <mongodb:createCollection collectionName="payments">
            <mongodb:options>
                {
                "validator": {
                "$jsonSchema": {
                "bsonType": "object",
                "required": ["id", "order_id", "user_id", "status", "timestamp", "payment_amount"],
                "properties": {
                "id": { "bsonType": "string" },
                "order_id": { "bsonType": "string" },
                "user_id": { "bsonType": "string" },
                "status": { "bsonType": "string" },
                "timestamp": { "bsonType": "date" },
                "payment_amount": { "bsonType": "double" }
                }
                }
                },
                "validationAction": "warn",
                "validationLevel": "strict"
                }
            </mongodb:options>
        </mongodb:createCollection>
    </changeSet>

</databaseChangeLog>